<Window x:Class="IRD2.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IRD2.UI"
        mc:Ignorable="d"
        Title="iRacing Replay Director 2.0" Height="600" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection Status Panel -->
        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="15" Height="15" Fill="Green" Margin="0,0,10,0" />
                <TextBlock Text="Connection Status:" FontWeight="Bold" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ConnectionStatus}" />
            </StackPanel>
        </Border>

        <!-- Session Information Panel -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Track:" FontWeight="Bold" />
                    <TextBlock Text="{Binding TrackName}" />
                    <TextBlock Text="Session:" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding SessionName}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Phase:" FontWeight="Bold" />
                    <TextBlock Text="{Binding SessionPhase}" />
                    <TextBlock Text="Time Remaining:" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding TimeRemaining}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Driver and Camera Selection Panel -->
        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Driver Selection -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Driver Selection:" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding DriverNames}" SelectedItem="{Binding SelectedDriverName}" Margin="0,5,0,5" Height="25" />
                    <Button Content="Switch Camera to Driver" Width="150" Height="25" Margin="0,5,0,0" Click="SwitchToSelectedDriver_Click" />
                </StackPanel>

                <!-- Camera Group Selection -->
                <StackPanel Grid.Row="3" Grid.Column="0">
                    <TextBlock Text="Camera Group Selection:" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding CameraGroupNames}" SelectedItem="{Binding SelectedCameraGroupName}" Margin="0,5,0,5" Height="25" />
                    <Button Content="Switch Camera to Group" Width="150" Height="25" Margin="0,5,0,0" Click="SwitchToSelectedCamera_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activity Log -->
        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Activity Log:" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,5" />
                <TextBox Grid.Row="1" Text="{Binding ActivityLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1" Padding="10">
            <TextBlock Text="IRD2.0 - iRacing Replay Director 2.0 - Milestone 1" Foreground="Gray" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
